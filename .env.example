# Upstash Redis (Vercel Marketplace > Upstash > Create Database > copy these two)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password to log into /dashboard
DASHBOARD_PASSWORD=change-me

# Any long random string, used to sign the dashboard login cookie
SESSION_SECRET=change-me-too-make-it-long-and-random

# Your deployed domain, no trailing slash, e.g. https://links.yoursite.com
# Used to build the full /l/slug links shown after you create one
NEXT_PUBLIC_SITE_URL=http://localhost:3000
